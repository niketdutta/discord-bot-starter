# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set this during development for instant, guild-scoped command deploys
# instead of global (global registration can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that bypass the permission system entirely.
BOT_OWNERS=

# Prefix used by the message-based (legacy) command handler.
DEFAULT_PREFIX=!

# Redeploy application commands on every boot. Fine to leave true for
# guild-scoped dev deploys (instant, effectively no rate limit). Set to
# false once running global commands across many guilds — global command
# updates are capped at 200/day per application — and deploy deliberately
# instead via `npm run deploy`.
AUTO_DEPLOY_COMMANDS=true

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# Postgres connection string (see vendor/platform-database).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot_starter

# Optional: Discord webhook URL (Server Settings -> Integrations -> Webhooks)
# that gets pinged on an uncaught exception / unhandled rejection. Leave
# blank to skip crash alerting.
ERROR_ALERT_WEBHOOK_URL=

# Optional: Sentry DSN for error monitoring (sentry.io -> Project Settings ->
# Client Keys (DSN)). Leave blank to skip Sentry entirely.
SENTRY_DSN=
