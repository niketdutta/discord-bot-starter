{
  "name": "discord-bot-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A Discord.js v14 bot starter — command/event/component loaders, cooldowns, permissions, structured logging, and crash-safe error handling already wired up, so you just add commands.",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:sharded": "node src/shard.js",
    "deploy": "node scripts/deploy-commands.js",
    "clear-global-commands": "node scripts/clear-global-commands.js",
    "migrate": "npm run migrate --prefix vendor/platform-database",
    "migrate:down": "npm run migrate:down --prefix vendor/platform-database",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test"
  },
  "dependencies": {
    "@platform/database": "file:vendor/platform-database",
    "@platform/shared": "file:vendor/platform-shared",
    "@sentry/node": "^10.68.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@platform/eslint-config": "file:vendor/platform-eslint-config",
    "eslint": "^9.13.0",
    "nodemon": "^3.1.7"
  }
}
